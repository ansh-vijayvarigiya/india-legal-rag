  "cards": [
    {
      "dot": "cyan",
      "title": "What the modules own",
      "items": [
        "config.py holds Settings; models.py holds Document, Chunk, Retrieved and make_chunk_id",
        "sources/rbi.py is the only source adapter; parse_document raises ParseError on an unrecognised page",
        "corpus.py owns every JSONL read and write, so no other module touches files directly"
      ]
    },
    {
      "dot": "emerald",
      "title": "Interfaces that matter",
      "items": [
        "Retriever is a protocol with one method, retrieve(query, k); DenseRetriever is its only implementation here",
        "Embedder.encode returns float32 (n, 384) and is the only place a model is loaded",
        "ChunkIndex wraps Qdrant; callers never see a Qdrant client"
      ]
    },
    {
      "dot": "rose",
      "title": "Designed, not built",
      "items": [
        "sources/ would add India Code and CBIC adapters beside rbi.py",
        "retrieve.py would add BM25, RRF and a reranker configuration behind the same protocol",
        "no module yet loads a language model for answers, citations or refusal"
      ]
    }
  ]
